# Copy to .env.local. For the local stack, `supabase start` prints both values
# (API URL and the anon / publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Optional: map style URL. Defaults to OpenFreeMap (no key needed). Swap in a
# MapTiler/Stadia style URL here to change providers.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
